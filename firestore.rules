rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if requesting user is an authorized admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Products Collection
    match /products/{productId} {
      // Anyone can read active products on the customer storefront
      allow read: if resource == null || resource.data.active == true || isAdmin();
      // Only verified admins can create, update, or delete products
      allow create, update, delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      // Customers cannot directly read all orders or edit orders
      // Orders are created safely via Server API Route with Firebase Admin SDK
      allow read, update, delete: if isAdmin();
      allow create: if true; // Allows server/client creation validation
    }

    // Admins Collection
    match /admins/{adminUid} {
      allow read: if request.auth != null && request.auth.uid == adminUid || isAdmin();
      allow write: if isAdmin();
    }
  }
}
