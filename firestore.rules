rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if requesting user is an authorized admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Products Collection
    match /products/{productId} {
      // Anyone can read active products on the customer storefront
      allow read: if resource == null || resource.data.active == true || isAdmin();
      // Only verified admins can create, update, or delete products
      allow create, update, delete: if isAdmin();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings Collection
    match /settings/{settingDoc} {
      allow read: if settingDoc in ['store', 'shipping'] || isAdmin();
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.customerId);
      allow create: if request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.total is number && request.resource.data.total >= 0;
      allow update, delete: if isAdmin();

      // Order events subcollection
      match /events/{eventId} {
        allow read: if resource.data.customerVisible == true || isAdmin();
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // Admins Collection
    match /admins/{adminUid} {
      allow read: if request.auth != null && request.auth.uid == adminUid || isAdmin();
      allow write: if isAdmin();
    }
  }
}
